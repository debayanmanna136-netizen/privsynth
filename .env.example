# =============================================================================
# PrivSynth - Environment Configuration Template
# Copy this file to .env for local/deployment overrides: cp .env.example .env
# =============================================================================

# Server network bindings (set to 0.0.0.0 in Docker containers)
HOST=127.0.0.1
PORT=8000

# Public HTTP port published by Nginx in Docker Compose (e.g. 80 or 8080)
PUBLIC_PORT=80

# Allowed CORS origins (comma-separated, or * for all)
# Defaults to local development ports (3000, 5500, 8080).
# When using Nginx reverse proxy, frontend and API share origin so CORS is not triggered.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Storage directory for generated synthetic CSVs and result metadata
# Defaults to backend/services/storage/ locally, or /app/storage in Docker
PRIVSYNTH_STORAGE_DIR=

# Maximum allowed CSV upload size in bytes (52428800 = 50 MB)
MAX_FILE_BYTES=52428800

# Maximum allowed CSV row count for synthesis
MAX_UPLOAD_ROWS=50000

# Retention threshold in hours for generated synthetic artifacts
RESULT_TTL_HOURS=24

# =============================================================================
# Vercel Deployment Settings (Hobby Plan & Serverless)
# =============================================================================
# Vercel Blob read-write token for serverless cloud persistence.
# Obtain from Vercel Project Dashboard -> Storage -> Vercel Blob -> Create Database.
# When omitted, PrivSynth falls back to local filesystem storage (ideal for local dev & VPS).
BLOB_READ_WRITE_TOKEN=

# Maximum allowed CSV row count for CTGAN execution on Vercel Serverless.
# CTGAN is computationally intensive; datasets exceeding this threshold will receive
# an honest, explanatory error guiding them to use Gaussian Copula or run on VPS/Docker.
VERCEL_MAX_CTGAN_ROWS=1000
